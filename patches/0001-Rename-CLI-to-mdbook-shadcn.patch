-        let mut cmd = Command::new(env!("CARGO_BIN_EXE_mdbook"));
+        let mut cmd = Command::new(env!("CARGO_BIN_EXE_mdbook-shadcn"));
         let output = cmd
             .arg("build")
             .arg("--dest-dir")
diff --git a/tests/testsuite/book_test.rs b/tests/testsuite/book_test.rs
index f29eab90..13f6426b 100644
--- a/tests/testsuite/book_test.rs
+++ b/tests/testsuite/book_test.rs
@@ -429,7 +429,7 @@ impl BookCommand {
 
