diff --git a/README.md b/README.md
index 224f3ad0..d29be887 100644
--- a/README.md
+++ b/README.md
@@ -1,10 +1,12 @@
-# mdBook
+# mdbook-shadcn
 
-[![CI Status](https://github.com/rust-lang/mdBook/actions/workflows/main.yml/badge.svg)](https://github.com/rust-lang/mdBook/actions/workflows/main.yml)
-[![crates.io](https://img.shields.io/crates/v/mdbook.svg)](https://crates.io/crates/mdbook)
 [![LICENSE](https://img.shields.io/github/license/rust-lang/mdBook.svg)](LICENSE)
 
-mdBook is a utility to create modern online books from Markdown files.
+mdbook-shadcn is a fork of [mdBook](https://github.com/rust-lang/mdBook), a utility to create modern online books from Markdown files.
+
+```bash
+cargo install mdbook-shadcn
+```
 
 Check out the **[User Guide]** for a list of features and installation and usage information.
 The User Guide also serves as a demonstration to showcase what a book looks like.
diff --git a/src/main.rs b/src/main.rs
index 68fea9c4..8dc87940 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -39,7 +39,7 @@ fn main() {
             clap_complete::generate(
                 *shell,
                 &mut complete_app,
-                "mdbook",
+                "mdbook-shadcn",
                 &mut std::io::stdout().lock(),
             );
             Ok(())
@@ -63,8 +63,8 @@ fn create_clap_command() -> Command {
         .propagate_version(true)
         .arg_required_else_help(true)
         .after_help(
-            "For more information about a specific command, try `mdbook <command> --help`\n\
-             The source code for mdBook is available at: https://github.com/rust-lang/mdBook",
+            "For more information about a specific command, try `mdbook-shadcn <command> --help`\n\
+             mdbook-shadcn is a fork of mdBook: https://github.com/rust-lang/mdBook",
         )
         .subcommand(cmd::init::make_subcommand())
         .subcommand(cmd::build::make_subcommand())
diff --git a/tests/gui/runner.rs b/tests/gui/runner.rs
index f036812c..2dd594dc 100644
--- a/tests/gui/runner.rs
+++ b/tests/gui/runner.rs
@@ -84,7 +84,7 @@ fn build_books(out_dir: &Path) {
             continue;
         }
